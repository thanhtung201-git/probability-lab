# Khóa API Groq: tạo tại https://console.groq.com/keys
# Để trống thì hệ thống chạy bằng bộ luật dự phòng.
GROQ_API_KEY=
# Mô hình Groq hỗ trợ structured outputs (strict): openai/gpt-oss-120b hoặc openai/gpt-oss-20b
GROQ_MODEL=openai/gpt-oss-120b
PORT=3001
DB_PATH=./probability-lab.db

# --- Khi triển khai lên mạng (xem DEPLOY.md) ---
# Mật khẩu chung tùy chọn, dạng ten:matkhau. Để trống thì ai có đường dẫn cũng dùng được.
PLAB_BASIC_AUTH=
# Số lần dùng chức năng có AI tối đa mỗi phút cho mỗi địa chỉ IP.
PLAB_GIOI_HAN_AI=60
